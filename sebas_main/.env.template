# Copy to .env and fill in. .env is gitignored; never commit real values.
#   PowerShell: Copy-Item .env.template .env

# Reasoning: Gemini key 1, then key 2 when key 1's quota runs out, then a local
# Ollama model. Quotas are per Google Cloud project, so take the two keys from
# different projects (or accounts). Keys: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_API_KEY_2=
# Pin a Gemini model instead of the newest stable Flash (optional)
SEBAS_GEMINI_MODEL=
# How hard Gemini thinks: minimal, low (default, quick), medium, high
SEBAS_GEMINI_THINKING=
# Force a specific local model instead of the automatic choice (see `ollama list`)
SEBAS_LOCAL_MODEL=

# AWS: devops_manager (read-only IAM credentials are sufficient)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# GitHub: github_assistant
GITHUB_PAT=

# Vercel: devops_manager
VERCEL_TOKEN=

# Weather: morning_briefing, and OpenJarvis's built-in get_weather tool
OPENWEATHERMAP_API_KEY=

# Vercel team ID, only if your projects belong to a team (optional)
VERCEL_TEAM_ID=

# Steam: leisure_tracker. Your 17-digit SteamID64; game details must be public.
STEAM_ID=
STEAM_COUNTRY=             # in (two-letter store region for prices)

# Morning briefing
SEBAS_HOME_LOCATION=       # e.g. Mumbai,IN
# Google Calendar: a "Desktop app" OAuth client from Google Cloud Console,
# then run custom_tools\setup_google_calendar.py once
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord: a private bot in your own server (see README, "Discord")
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=           # blank: the server owner is the master; or a numeric user ID
DISCORD_GUILD_ID=          # only if the bot is in more than one server

# AniList: ANILIST_TOKEN from the one-time sign-in (see README); or ANILIST_USER for read-only
ANILIST_TOKEN=
ANILIST_USER=

# Proactive butler (optional; blank uses the default shown)
SEBAS_PROACTIVE=           # on  (off disables briefings, check-ins and alerts)
SEBAS_BRIEFING_TIME=       # 07:00  morning briefing, the first time you're at the laptop after this
SEBAS_EVENING_TIME=        # 21:30  evening check-in and journal (weekly recap on Sundays)

# Voice settings (optional; blank uses the default shown)
# Your name, for calls: "This is Sebas, <name>'s assistant" (blank: "a personal assistant").
# Several, comma-separated ("Krishiv, Hermit"): he asks "Krishiv or Hermit, sir?" each time.
SEBAS_MASTER_NAME=
# Whisper models: a quick one that listens for "Sebas", an accurate one for requests
SEBAS_NAME_MODEL=          # tiny.en
SEBAS_WHISPER_MODEL=       # small.en
SEBAS_VOICE=               # bm_george (also bm_lewis, bm_daniel, bm_fable)
# After a reply, keep listening this long for a follow-up without "Sebas"; 0 turns it off
SEBAS_FOLLOW_UP_SECONDS=   # 8
# Run "python run_sebas.py --mic-test" for a value suited to your microphone
SEBAS_SILENCE_THRESHOLD=   # 500
