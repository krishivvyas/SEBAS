{
  "manifest_version": 3,
  "name": "Sebas Browser Hands",
  "version": "1.0.0",
  "key": "",
  "description": "Lets Sebas, running on this computer, open one tab and browse in it when you ask him to. He works only in the tab he opens.",
  "permissions": ["tabs", "scripting", "alarms", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Sebas Browser Hands" }
}
